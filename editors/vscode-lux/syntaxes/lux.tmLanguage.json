{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lux Script",
  "scopeName": "source.lux",
  "fileTypes": ["lux"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#app-block" },
    { "include": "#triple-strings" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords-route" },
    { "include": "#keywords-on-error" },
    { "include": "#keywords-control" },
    { "include": "#keywords-declaration" },
    { "include": "#constants" },
    { "include": "#storage-types" },
    { "include": "#reserved-objects" },
    { "include": "#arrow" },
    { "include": "#functions" },
    { "include": "#named-arg" },
    { "include": "#type-names" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.lux",
          "match": "#.*$"
        }
      ]
    },
    "app-block": {
      "comment": "The app: header and everything indented under it (including a nested module block like sqlite:) -- a bare identifier at the start of a line in here (name, port, file, pool...) is a config key, not a variable/function/keyword, and gets its own scope so it is not left uncolored.",
      "begin": "^(\\s*)(app)(:)[ \\t]*$",
      "beginCaptures": {
        "2": { "name": "keyword.other.declaration.lux" },
        "3": { "name": "punctuation.lux" }
      },
      "end": "^(?!\\1[ \\t]+\\S|[ \\t]*$)",
      "patterns": [
        { "include": "#comments" },
        { "include": "#triple-strings" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#constants" },
        { "include": "#arrow" },
        {
          "match": "^[ \\t]*([a-zA-Z_][a-zA-Z0-9_]*)\\b(?=[ \\t]|$)",
          "captures": { "1": { "name": "support.type.property-name.lux" } }
        },
        { "include": "#punctuation" }
      ]
    },
    "triple-strings": {
      "name": "string.quoted.triple.lux",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        {
          "name": "constant.character.escape.lux",
          "match": "\\\\[ntr0\"\\\\]"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.lux",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.lux",
          "match": "\\\\[ntr0\"\\\\]"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.lux",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.lux",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords-route": {
      "patterns": [
        {
          "name": "keyword.control.route.lux",
          "match": "\\b(get|post|put|patch|delete|any|sse|ws)\\b(?=\\s+endpoint\\b)"
        },
        {
          "name": "keyword.control.route.lux",
          "match": "\\bendpoint\\b"
        },
        {
          "name": "keyword.other.route-modifier.lux",
          "match": "\\borigins\\b"
        }
      ]
    },
    "keywords-on-error": {
      "name": "keyword.control.error-handler.lux",
      "match": "\\bon\\s+error\\b"
    },
    "keywords-control": {
      "patterns": [
        {
          "name": "keyword.control.lux",
          "match": "\\b(if|elif|else|while|for|in|return|require|try|catch|break|continue|and|or|not)\\b"
        }
      ]
    },
    "keywords-declaration": {
      "patterns": [
        {
          "name": "keyword.other.declaration.lux",
          "match": "\\b(import|class|fn|app|group|validate|spa)\\b"
        }
      ]
    },
    "constants": {
      "name": "constant.language.lux",
      "match": "\\b(true|false|null)\\b"
    },
    "storage-types": {
      "patterns": [
        {
          "name": "storage.type.primitive.lux",
          "match": "\\b(int|long|float|double|bool|string|void)\\b"
        },
        {
          "name": "support.type.native.lux",
          "match": "\\b(Json|List|Dict|File)\\b"
        }
      ]
    },
    "reserved-objects": {
      "patterns": [
        {
          "name": "variable.language.lux",
          "match": "\\b(request|session|state|jwt|log|this)\\b"
        },
        {
          "name": "variable.language.lux",
          "match": "\\b(sse|ws|error)\\b(?=\\s*\\.)"
        }
      ]
    },
    "arrow": {
      "name": "keyword.operator.arrow.lux",
      "match": "->"
    },
    "functions": {
      "name": "entity.name.function.lux",
      "match": "\\b([a-z_][a-zA-Z0-9_]*)\\b(?=\\s*\\()"
    },
    "named-arg": {
      "comment": "An identifier directly before '=' (not '=='): render(x, title=\"...\") and a plain assignment target (x = 5) both match -- there is no cheap way in a regex grammar to tell 'named call argument' from 'assignment' apart, and coloring both consistently is a reasonable, not incorrect, outcome.",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b(?=[ \\t]*=(?!=))",
      "captures": { "1": { "name": "variable.parameter.lux" } }
    },
    "type-names": {
      "name": "entity.name.type.lux",
      "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.lux",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.increment.lux",
          "match": "(\\+\\+|--)"
        },
        {
          "name": "keyword.operator.arithmetic.lux",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.ternary.lux",
          "match": "(\\?|:)"
        },
        {
          "name": "keyword.operator.assignment.lux",
          "match": "="
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.lux",
          "match": ","
        },
        {
          "name": "punctuation.accessor.lux",
          "match": "\\."
        },
        {
          "name": "punctuation.section.brackets.lux",
          "match": "[\\[\\]{}()]"
        }
      ]
    }
  }
}
