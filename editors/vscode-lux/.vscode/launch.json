{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Lux Script extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/out/**/*.js", "${workspaceFolder}/server/out/**/*.js"],
      "preLaunchTask": "npm: compile"
    }
  ]
}
