# Native modules (NATIVE-MODULES.md): a compiled-in, `import`-gated
# capability, distinct from the DB drivers (sqlite/postgres/mysql) -- always
# synchronous, no `app:` configuration block required. `hash` is the proof
# module: three thin wrappers over crypto.hpp (already exercised indirectly
# by the session/jwt suite), here checked directly and hex-encoded. `csv`
# has no external dependency either (unlike `pdf`, which has its own suite
# -- run_pdf.sh -- to skip gracefully on a binary built without cairo), so
# it belongs in the always-runs regression suite too.
import hash
import text
import encoding
import json
import csv
import os
import math
import time
import regex
import rooms
import proc

get endpoint("/hash/:s", string s):
    return { "sha256": hash.sha256(s) }

get endpoint("/hmac/:key/:msg", string key, string msg):
    return { "mac": hash.hmac_sha256(key, msg) }

get endpoint("/random/:n", int n):
    return { "hex": hash.random_hex(n) }

get endpoint("/hash/password"):
    string h = await hash.password("hunter2")
    bool good = await hash.verify("hunter2", h)
    bool bad = await hash.verify("hunter3", h)
    bool django = await hash.verify("pw", "pbkdf2_sha256$1000$salt123$MWa8jc85h8c6c8Jm+w5qVekbz0jT4egNnQ5GJ8LeL5w=")
    bool garbage = await hash.verify("pw", "not a hash")
    return { "format": h.starts_with("pbkdf2_sha256$600000$"), "good": good, "bad": bad, "django": django, "garbage": garbage }

get endpoint("/hash/sign"):
    string t = hash.sign({ "user": 7 }, "k1")
    return { "back": hash.unsign(t, "k1"), "tampered": hash.unsign(t + "x", "k1"), "wrong_key": hash.unsign(t, "k2"), "fresh": hash.unsign(t, "k1", 60), "expired": hash.unsign(t, "k1", -1) }

get endpoint("/hash/ids"):
    string u4 = hash.uuid()
    string u7 = hash.uuid(7)
    return { "len": len(u4), "v4": u4.slice(14, 15), "v7": u7.slice(14, 15), "token_len": len(hash.token()), "same": hash.equal("abc", "abc"), "differ": hash.equal("abc", "abd") }

get endpoint("/hash/bad_arg"):
    return { "h": hash.sha256(5) }

get endpoint("/math/more"):
    List<Json> xs = [4, 9, 2]
    List<Json> shuffled = math.shuffle(xs)
    return { "round2": math.round(3.14159, 2), "clamp": math.clamp(15, 0, 10), "sign": math.sign(-3), "min_list": math.min(xs), "max3": math.max(1, 7, 3), "log2": math.log(8, 2), "choice_in": xs.contains(math.choice(xs)), "shuffled_len": len(shuffled), "sample_len": len(math.sample(xs, 2)), "untouched": xs }

get endpoint("/math/domain"):
    return { "r": math.sqrt(-1) }

get endpoint("/json/pretty"):
    return text(json.stringify({ "a": [1, 2], "b": {}, "c": { "d": null } }, 2))

get endpoint("/encoding/basic"):
    return { "b64": encoding.base64_encode("hi?>"), "b64url": encoding.base64_encode("hi?>", true), "back": encoding.base64_decode("aGk/Pg=="), "hex": encoding.hex_decode(encoding.hex_encode("ok")), "url": encoding.url_decode(encoding.url_encode("a b/ñ")), "query": encoding.query_encode({ "q": "a b", "tag": ["x", "y"], "skip": null }), "parsed": encoding.query_decode("?a=1&b=x+y"), "html": encoding.html_escape("<a href='x'>") }

get endpoint("/encoding/url"):
    return { "full": encoding.url_parse("https://u@a.com:8080/p/x?q=1#top"), "relative": encoding.url_parse("/next?x=1"), "sneaky": encoding.url_parse(" /\\evil.com/x") }

get endpoint("/encoding/bad_hex"):
    return { "r": encoding.hex_decode("zz") }

get endpoint("/text/basic"):
    return { "slug": text.slug("¡Café con Leche! 2024 — Łódź"), "trunc": text.truncate("Hello world", 8), "short": text.truncate("Hi", 8), "num": text.format_number(1234567.891, 2), "num_es": text.format_number(-1234567.891, 2, ".", ","), "pad": text.pad_left("7", 4, "0"), "padr": text.pad_right("ñ", 3, "."), "dist": text.distance("kitten", "sitting") }

get endpoint("/state/ttl"):
    state.remove("hits")
    int a = state.incr("hits", 1, 200)
    int b = state.incr("hits", 1, 200)
    state.set("token", "abc", 200)
    Json before = state.get("token")
    await sleep(260)
    int c = state.incr("hits", 1, 200)
    return { "a": a, "b": b, "after_window": c, "before": before, "expired": state.get("token"), "default": state.get("token", "none") }

get endpoint("/state/plain"):
    state.set("k", { "x": 1 })
    int n = state.incr("n")
    state.decr("n", 3)
    return { "k": state.get("k"), "n": state.get("n"), "removed": state.remove("k"), "gone": state.get("k") }

get endpoint("/time/calendar"):
    int ts = time.parse_iso("2024-01-31T15:30:00Z")
    return { "parts": time.parts(ts), "feb": time.format_iso(time.add_months(ts, 1)), "feb_2023": time.format_iso(time.add_months(time.parse_iso("2023-01-31T00:00:00Z"), 1)), "back": time.format_iso(time.add_months(ts, -13)), "day": time.format_iso(time.start_of(ts, "day")), "week": time.format_iso(time.start_of(ts, "week")), "month": time.format_iso(time.start_of(ts, "month")), "year": time.format_iso(time.start_of(ts, "year")), "day_cet": time.format_iso(time.start_of(time.parse_iso("2024-01-31T23:30:00Z"), "day", 60)) }

get endpoint("/time/ago"):
    int now = time.parse_iso("2024-06-01T12:00:00Z")
    return { "just": time.ago(now - 5000, now), "min": time.ago(now - 180000, now), "hour": time.ago(now - 3600000, now), "future": time.ago(now + 7200000, now), "es": time.ago(now - 3 * 86400000, now, "es"), "es_month": time.ago(now - 65 * 86400000, now, "es"), "es_future": time.ago(now + 60000, now, "es"), "ms": time.parse_iso("2024-06-01T12:00:00.5+02:00") }

get endpoint("/regex/escape"):
    string raw = "a.b-c/d(e)[f]{2}*+?^$|\\"
    string p = regex.escape(raw)
    return { "self": regex.test("^" + p + "$", raw), "other": regex.test("^" + p + "$", "aXb-c/d(e)[f]{2}*+?^$|\\"), "cached": regex.test("^" + p + "$", raw) }

ws endpoint("/room/:id", string id) origins("http://localhost"):
    rooms.join("room-" + id)
    ws.send("joined")
    while ws.open:
        string msg = await ws.recv()
        if msg == null:
            break
        if msg == "count":
            ws.send(str(rooms.count("room-" + id)))
        else:
            rooms.broadcast_others("room-" + id, { "from": msg })
    rooms.leave_all()

get endpoint("/os/run_options"):
    Json piped = await os.run("cat", [], { "input": "fed through stdin" })
    Json where = await os.run("pwd", [], { "cwd": "/tmp" })
    Json env = await os.run("sh", ["-c", "echo $LUX_T"], { "env": { "LUX_T": "set" } })
    Json slow = await os.run("sleep", ["5"], { "timeout_ms": 100 })
    return { "stdin": piped["stdout"], "cwd": where["stdout"], "env": env["stdout"], "timeout": slow }

get endpoint("/os/files_more"):
    string dir = os.path_join(os.temp_dir(), "lux-files-more")
    os.remove_dir(dir, true)
    os.make_dir(os.path_join(dir, "sub"))
    await os.write_file(os.path_join(dir, "a.txt"), "one")
    await os.append_file(os.path_join(dir, "a.txt"), "+two")
    await os.write_file(os.path_join(dir, "b.JPG"), "")
    await os.write_file(os.path_join(dir, "sub", "c.txt"), "")
    string tmp = os.temp_file(".pdf")
    Json r = { "appended": await os.read_file(os.path_join(dir, "a.txt")), "glob": os.glob(os.path_join(dir, "*.txt")), "tree": os.list_dir(dir, true).sort(), "mime": os.mime("b.JPG"), "mime_unknown": os.mime("x.nope"), "ext": os.path_ext("a/b.tar.gz"), "tmp_ok": os.is_file(tmp) and tmp.ends_with(".pdf") }
    os.remove_file(tmp)
    os.remove_dir(dir, true)
    return r

get endpoint("/proc/stdin"):
    int h = proc.start("cat", [], { "stdin": "pipe" })
    int n = proc.write(h, "ping")
    proc.write(h, null)
    string got = await proc.read(h, 100, 2000)
    int code = await proc.wait(h, 2000)
    proc.close(h)
    return { "written": n, "echo": got, "code": code }

get endpoint("/csv/basic"):
    string data = "name,age,city\nana,30,madrid\nbob,25,paris\ncleo,35,madrid\n"
    int h = csv.parse(data)
    List<Json> cols = csv.columns(h)
    List<Json> rows = csv.rows(h)
    int n = csv.row_count(h)
    csv.close(h)
    return { "columns": cols, "rows": rows, "row_count": n }

fn bool in_madrid(Json r):
    return r["city"] == "madrid"

fn int add_age(int acc, Json r):
    return acc + r["age"]

get endpoint("/csv/read_and_aggregate"):
    List<Json> rows = csv.read("name,age,city\nana,30,madrid\nbob,25,paris\ncleo,35,madrid\n")
    List<Json> madrid = rows.filter(in_madrid)
    return { "madrid": madrid, "total_age": rows.reduce(add_age, 0), "first": rows[0] }

get endpoint("/csv/excel"):
    List<Json> rows = csv.read("﻿nombre;precio\n\"Pérez; J.\";1,5\n", true, ";")
    return { "rows": rows, "out": csv.write(rows, null, ";") }

get endpoint("/csv/write"):
    List<Json> rows = [{ "a": 1, "b": "x,y" }, { "a": "=cmd", "b": null }]
    return { "dicts": csv.write(rows), "lists": csv.write([[1, 2], [3, 4]], ["p", "q"]) }

get endpoint("/csv/quoted"):
    string data = "name,note\n\"Smith, John\",\"He said \"\"hi\"\"\"\nplain,ok\n"
    int h = csv.parse(data)
    List<Json> rows = csv.rows(h)
    csv.close(h)
    return { "rows": rows }

get endpoint("/csv/roundtrip"):
    string data = "a,b\n1,2\n3,4\n"
    int h = csv.parse(data)
    string back = csv.to_csv(h)
    csv.close(h)
    return { "csv": back }

get endpoint("/csv/closed_handle"):
    int h = csv.parse("a,b\n1,2\n")
    csv.close(h)
    List<Json> rows = csv.rows(h)
    return { "unreachable": rows }

get endpoint("/os/env"):
    string missing = os.getenv("LUX_DEFINITELY_NOT_SET_XYZ", "fallback")
    Json present = os.getenv("LUX_TEST_TMP")
    return { "missing_uses_default": missing, "present_is_not_null": present != null }

get endpoint("/os/path"):
    string joined = os.path_join("a", "b", "c.txt")
    string base = os.path_basename("/x/y/z.txt")
    string dir = os.path_dirname("/x/y/z.txt")
    return { "joined": joined, "base": base, "dir": dir }

get endpoint("/os/file_roundtrip"):
    string tmp = os.getenv("LUX_TEST_TMP", "/tmp")
    string dir = os.path_join(tmp, "os_test")
    os.make_dir(dir)
    string path = os.path_join(dir, "hello.txt")
    await os.write_file(path, "hola mundo")
    bool existed_before = os.path_exists(path)
    string content = await os.read_file(path)
    List<Json> entries = os.list_dir(dir)
    bool removed = os.remove_file(path)
    bool exists_after = os.path_exists(path)
    return { "existed_before": existed_before, "content": content, "entries": entries,
              "removed": removed, "exists_after": exists_after }

get endpoint("/os/missing_file"):
    Json content = await os.read_file("/definitely/does/not/exist/xyz123")
    return { "content_is_null": content == null }

get endpoint("/os/stat"):
    string tmp = os.getenv("LUX_TEST_TMP", "/tmp")
    string dir = os.path_join(tmp, "os_stat_test")
    os.make_dir(dir)
    string file = os.path_join(dir, "stat_me.txt")
    await os.write_file(file, "12345")
    bool dir_is_dir = os.is_dir(dir)
    bool dir_is_file = os.is_file(dir)
    bool file_is_dir = os.is_dir(file)
    bool file_is_file = os.is_file(file)
    int size = os.file_size(file)
    int dir_size = os.file_size(dir)
    bool mtime_positive = os.mtime_ms(file) > 0
    os.remove_file(file)
    return { "dir_is_dir": dir_is_dir, "dir_is_file": dir_is_file,
              "file_is_dir": file_is_dir, "file_is_file": file_is_file,
              "size": size, "dir_size": dir_size, "mtime_positive": mtime_positive }

get endpoint("/os/stat_missing"):
    string missing = "/definitely/does/not/exist/xyz123"
    return { "is_dir": os.is_dir(missing), "is_file": os.is_file(missing),
              "size": os.file_size(missing), "mtime": os.mtime_ms(missing) }

