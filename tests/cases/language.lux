app:
    port 8790

get endpoint("/__ping__"):
    return { "ok": true }

get endpoint("/arithmetic"):
    return { "sum": 3 + 4, "resta": 10 - 3, "div": 9 / 3, "mod": 7 % 3, "mixto": 1 + 2.5 }

get endpoint("/strings"):
    string s = "hello"
    return { "upper": s.upper(), "starts": s.starts_with("he"), "trimmed": "  x  ".trim() }

# JSON has to be UTF-8.  A stray byte comes in through the body, the query or
# a header, and without sanitizing it left the response unreadable for the
# client that sent it.  These routes return what comes in, to check both
# halves: that the broken is sanitized and the valid is NOT touched.
get endpoint("/echo_query", string q = "empty"):
    return { "echo": q }

get endpoint("/echo_header"):
    return { "echo": header("X-Test") }

get endpoint("/echo_valid"):
    return { "echo": "añoñó 🐻 ñ" }

get endpoint("/multiline"):
    string sql = """
        SELECT id
        FROM posts
        """
    string loose = """on one line"""
    return { "sql": sql, "loose": loose, "escapes": """with \"quotes\"""" }

get endpoint("/truthiness"):
    List<int> vacia = []
    return { "zero": 0 ? true : false, "vacia": vacia ? true : false,
             "text": "" ? true : false, "one": 1 ? true : false }

get endpoint("/coercion"):
    return { "bad": 1 + "one" }

get endpoint("/classify/:n", int n):
    if n < 0:
        return { "r": "negative" }
    elif n == 0:
        return { "r": "zero" }
    elif n < 10:
        return { "r": "small" }
    else:
        return { "r": "big" }

get endpoint("/sum_up_to/:n", int n):
    int total = 0
    int i = 1
    while i <= n:
        total += i
        i++
    return { "total": total }

get endpoint("/evens"):
    List<int> out = []
    for int x in [1, 2, 3, 4, 5, 6, 7]:
        if x > 6:
            break
        if x % 2 != 0:
            continue
        out.add(x)
    return { "evens": out }

get endpoint("/operators"):
    int a = 10
    a += 5
    a -= 3
    a *= 2
    a /= 4
    a %= 4
    return { "a": a }

get endpoint("/increment"):
    int i = 5
    int previo = i++
    int nuevo = ++i
    return { "post": previo, "pre": nuevo, "i": i }

get endpoint("/indices"):
    List<int> l = [10, 20, 30]
    l[0] = 99
    l[2] = l[1] + 5
    return { "l": l }

get endpoint("/ternary/:age", int age):
    return { "role": age >= 18 ? "adult" : "minor" }

get endpoint("/captura"):
    try:
        int x = 1 / 0
        return { "no": x }
    catch e:
        return { "caught": e.message }

get endpoint("/boom"):
    return { "bad": 1 / 0 }

get endpoint("/strings2"):
    string s = "Hello, World"
    return {
        "index_of": s.index_of("World"), "index_of_missing": s.index_of("xyz"),
        "replace": s.replace("o", "0"), "split": s.split(", "),
        "slice": s.slice(0, 5), "slice_neg": s.slice(-5),
        "repeat": "ab".repeat(3)
    }

get endpoint("/lists2"):
    List<int> a = [3, 1, 4, 1, 5]
    List<int> b = [3, 1, 4, 1, 5]
    return {
        "contains": a.contains(4), "index_of": a.index_of(4),
        "sorted": a.sort(), "reversed": b.reverse(),
        "slice": [10, 20, 30, 40].slice(1, 3),
        "concat": [1, 2].concat([3, 4]), "join": [1, 2, 3].join("-")
    }

get endpoint("/list_remove_at"):
    List<int> l = [10, 20, 30]
    bool removed = l.remove_at(1)
    bool oob = l.remove_at(99)
    return { "removed": removed, "out_of_range": oob, "after": l }

get endpoint("/sort_mixed_types"):
    List<Json> l = [1, "two", 3]
    return { "unreachable": l.sort() }

get endpoint("/dicts2"):
    Dict<string, int> d = {"a": 1, "b": 2}
    Dict<string, int> e = {"a": 1, "b": 2}
    return {
        "values": d.values(), "get_present": d.get("a", -1), "get_missing": d.get("z", -1),
        "removed": e.remove("a"), "after_remove": e, "merged": {"x": 1}.merge({"y": 2})
    }

# Function references (NOT closures -- no captured environment, just which
# function, see Value::Type::Func, value.hpp): a bare `fn` name used where a
# value is expected, consumed by List.map/filter/reduce/for_each.
fn int double_it(int x):
    return x * 2

fn bool is_even(int x):
    return x % 2 == 0

fn int add(int acc, int x):
    return acc + x

fn Json side_effect(int x):
    int cur = state.get("func_total")
    state.set("func_total", cur + x)
    return null

fn Json calls_await(int x):
    Json r = await sleep(1)
    return r

# A plain `fn` that awaits something directly, called normally (not through
# a callback like .map() above) -- project.cpp's has_await used to only be
# set on THIS function's own chunk, never propagated to a caller that just
# calls it, so the caller's own chunk looked synchronous when it was not.
# That sent the whole call through a blocking-pool worker's unrelated
# thread_local VM instead of the per-request one actually capable of being
# resumed: the callee still suspended correctly, but nothing was listening
# for it, and the caller ended up resuming an empty, never-started VM that
# fell straight through to a default null result -- the value made it out
# of `five_after_await` and was lost one frame up, every time, with no
# error at all.
fn int five_after_await():
    await sleep(1)
    return 5

# Two calls deep: five_after_await()'s has_await has to propagate through
# THIS function too, not just to its immediate, direct caller.
fn int add_one_after_await(int x):
    int v = await five_after_await()
    return v + x

get endpoint("/func_ref"):
    Json f = double_it
    return { "is_not_null": f != null }

get endpoint("/list_map"):
    List<int> l = [1, 2, 3, 4]
    return { "doubled": l.map(double_it) }

get endpoint("/list_filter"):
    List<int> l = [1, 2, 3, 4, 5, 6]
    return { "evens": l.filter(is_even) }

get endpoint("/list_reduce"):
    List<int> l = [1, 2, 3, 4, 5]
    return { "sum": l.reduce(add, 0) }

get endpoint("/list_for_each"):
    List<int> l = [1, 2, 3]
    state.set("func_total", 0)
    l.for_each(side_effect)
    return { "total": state.get("func_total") }

get endpoint("/list_map_filter_chain"):
    List<int> l = [1, 2, 3, 4, 5, 6, 7, 8]
    return { "r": l.filter(is_even).map(double_it) }

# A callback that itself calls .reduce() again -- the case that would
# corrupt a shared/thread_local VM (see call_func_value's comment,
# natives.cpp) if call_func_value reused one instead of a fresh VM per call.
fn int sum_list(List<int> l):
    return l.reduce(add, 0)

get endpoint("/list_map_nested"):
    List<List<int>> ll = [[1, 2], [3, 4]]
    return { "r": ll.map(sum_list) }

get endpoint("/list_map_await_rejected"):
    List<int> l = [1]
    return { "r": l.map(calls_await) }

get endpoint("/fn_return_after_await"):
    int v = await five_after_await()
    return { "v": v }

get endpoint("/fn_return_after_await_bare"):
    return await five_after_await()

get endpoint("/fn_transitively_awaits"):
    int v = await add_one_after_await(10)
    return { "v": v }

class ChainPoint:
    int x
    int y

    fn int squared():
        return this.x * this.x + this.y * this.y

fn ChainPoint make_chain_point(int x, int y):
    return ChainPoint(x, y)

# type_of() used to only know the type of a Call expression for a BUILTIN
# method on an already-typed receiver, never for a call to a user function
# or constructor -- chaining a class method straight off one
# (`make_chain_point(3, 4).squared()`, no intermediate variable) failed at
# runtime with "Dicts have no method 'squared'" even though this compiled
# clean: the checker had no way to know the call's result was a
# ChainPoint, so it fell through to the generic Dict method dispatch. See
# To_Add.md for the full writeup (now marked fixed).
get endpoint("/chain_call_method"):
    return { "r": make_chain_point(3, 4).squared() }

get endpoint("/range"):
    return {
        "one_arg": range(5), "two_args": range(2, 6),
        "step": range(0, 10, 2), "negative_step": range(5, 0, -1)
    }

get endpoint("/range_for_loop"):
    int total = 0
    for int i in range(1, 5):
        total = total + i
    return { "total": total }

get endpoint("/range_bad_step"):
    return { "r": range(0, 5, 0) }

# switch: sugar for an if/elif chain (see parse_switch_into, parser.cpp) --
# nothing downstream ever sees a switch, only an If.
get endpoint("/switch_basic/:n", int n):
    string r = "?"
    switch n:
        case 1:
            r = "one"
        case 2:
            r = "two"
        else:
            r = "many"
    return { "r": r }

get endpoint("/switch_no_else/:n", int n):
    string r = "unset"
    switch n:
        case 1:
            r = "one"
    return { "r": r }

get endpoint("/switch_multi_value/:n", int n):
    string r = "?"
    switch n:
        case 1, 2, 3:
            r = "low"
        case 4, 5:
            r = "mid"
        else:
            r = "high"
    return { "r": r }

fn int switch_side_effect_count():
    int c = state.get("switch_calls")
    state.set("switch_calls", c + 1)
    return c

# The subject is evaluated exactly once into a synthetic temp, not once per
# case: if this were re-evaluating it, "calls" would be 2 or 3, not 1.
get endpoint("/switch_eval_once"):
    state.set("switch_calls", 0)
    string r = "?"
    switch switch_side_effect_count():
        case 0:
            r = "zero"
        case 1:
            r = "one"
    return { "r": r, "calls": state.get("switch_calls") }

# enum: a member is a plain string constant (its own name), not an index --
# see EnumDecl's comment (ast.hpp).
enum Color:
    RED
    GREEN
    BLUE

enum Status:
    PENDING, ACTIVE, DONE

get endpoint("/enum_basic"):
    return { "c": Color.RED, "s": Status.ACTIVE }

get endpoint("/enum_compare/:c", string c):
    return { "is_red": c == Color.RED }

get endpoint("/enum_switch"):
    string status = Status.ACTIVE
    string label = "?"
    switch status:
        case Status.PENDING:
            label = "waiting"
        case Status.ACTIVE:
            label = "in progress"
        case Status.DONE:
            label = "finished"
    return { "label": label }

class EnumOrder:
    string status

    validate:
        status == Status.PENDING or status == Status.ACTIVE or status == Status.DONE   "status: invalid"

post endpoint("/enum_order", EnumOrder o):
    return { "status": o.status }
