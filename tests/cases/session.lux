app:
    port 8790

    session:
        secret "test-session-secret-long-enough-for-hmac256"
        secure false

    jwt:
        secret "test-jwt-secret-long-enough-for-hmac-signing"
        issuer "tests"

get endpoint("/__ping__"):
    return { "ok": true }

get endpoint("/whoami"):
    return { "user": session.user, "role": session.role }

group("/admin"):
    require session.role == "admin" else status(403)

    get endpoint("/panel"):
        return { "panel": true }

group("/api"):
    require jwt.valid else status(401)

    get endpoint("/me"):
        return { "sub": jwt.claims["sub"] }

post endpoint("/login", string user, string role):
    session.user = user
    session.role = role
    return { "ok": true }

post endpoint("/logout"):
    session.clear()
    return { "ok": true }

post endpoint("/token"):
    return { "token": jwt.sign({ "sub": "u7" }, 600) }

get endpoint("/verify", string token = ""):
    Json c = jwt.verify(token)
    if c == null:
        return { "valid": false }
    return { "valid": true, "sub": c["sub"], "iss": c["iss"] }

# A stream's guard answers before the stream opens: a 401, not a socket or
# an event stream that closes at once.
group("/live"):
    require jwt.verify(query("token", "")) != null else status(401)

    sse endpoint("/feed", string token = ""):
        sse.send("hi")

    ws endpoint("/chat", string token = "") origins("http://t.test"):
        ws.send("hi")
        ws.close()
