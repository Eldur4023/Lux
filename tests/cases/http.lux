# Native module `http` (NATIVE-MODULES.md) -- own suite (run_http.sh), same
# reason pdf/sqlite/postgres/mysql each have one: libcurl is an optional
# compiled-in dependency (LUX_HTTP) and has to skip gracefully, not fail,
# on a binary built without it.
#
# Calls a local echo server (tests/http_echo_server.py) on a fixed port
# instead of the real internet: deterministic, no network flakiness, and
# the suite still proves the real thing -- an actual TCP connection, an
# actual HTTP/1.1 request/response cycle through libcurl, not a mock.
import http

get endpoint("/get_basic"):
    Json r = await http.get("http://127.0.0.1:8899/echo?x=1")
    return r

get endpoint("/get_with_headers"):
    Json r = await http.get("http://127.0.0.1:8899/echo", { "X-Test": "hello" })
    return r

get endpoint("/post_json"):
    Json r = await http.post("http://127.0.0.1:8899/echo", { "name": "ana", "age": 30 })
    return r

get endpoint("/post_raw_string"):
    Json r = await http.post("http://127.0.0.1:8899/echo", "plain text body")
    return r

get endpoint("/put_json"):
    Json r = await http.put("http://127.0.0.1:8899/echo", { "updated": true })
    return r

get endpoint("/patch_json"):
    Json r = await http.patch("http://127.0.0.1:8899/echo", { "patched": true })
    return r

get endpoint("/delete_basic"):
    Json r = await http.delete("http://127.0.0.1:8899/echo")
    return r

get endpoint("/status_404"):
    Json r = await http.get("http://127.0.0.1:8899/status/404")
    return r

get endpoint("/status_500"):
    Json r = await http.get("http://127.0.0.1:8899/status/500")
    return r

get endpoint("/bad_url"):
    Json r = await http.get("not-a-url")
    return r

get endpoint("/connection_refused"):
    Json r = await http.get("http://127.0.0.1:1")
    return r
